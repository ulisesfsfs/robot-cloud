  {
    "id": "d_ctl",
    "type": "function",
    "z": "robotdash",
    "name": "Control robot",
    "func": "// ===== Configuración =====\nconst MAX_SPEED   = 80;   // tope de velocidad (%), batería 9 V / motor 6 V\nconst SERVO_LEFT   = 500;   // µs izquierda total (calibrado)\nconst SERVO_CENTER = 1200;  // µs recto (calibrado)\nconst SERVO_RIGHT  = 2500;  // µs derecha total (calibrado)\nconst BRAKE_MS    = 200;  // pausa al cambiar de sentido\nconst LIMITE_CM   = 20;   // si hay algo más cerca que esto, no deja ir adelante\n\n// Estado actual (se guarda entre mensajes)\nlet st = flow.get(\"robot\") || { cmd: \"stop\", speed: 60, steer: 0 };\nconst prevCmd = st.cmd;\n\n// Leer lo que mandó el tablero (o el inject de inicio)\nconst p = (typeof msg.payload === \"object\" && msg.payload) ? msg.payload : {};\nif ([\"adelante\", \"atras\", \"stop\"].includes(p.cmd)) st.cmd = p.cmd;\nif (p.speed !== undefined && !isNaN(p.speed)) st.speed = Math.max(0, Math.min(MAX_SPEED, Number(p.speed)));\nif (p.steer !== undefined && !isNaN(p.steer)) st.steer = Math.max(-100, Math.min(100, Number(p.steer)));\n// Freno por obstáculo: no permite avanzar si hay algo muy cerca (atrás sí)\nconst dist = flow.get(\"distancia\");\nst.bloqueado = st.cmd === \"adelante\" && typeof dist === \"number\" && dist < LIMITE_CM;\nif (st.bloqueado) st.cmd = \"stop\";\nflow.set(\"robot\", st);\n\n// ---- Motor: [Izq PWM, Izq 1, Izq 2, Der PWM, Der 1, Der 2] ----\nfunction pines(pwm, dir) {\n    return [{payload:pwm},{payload:dir},{payload:dir?0:1},\n            {payload:pwm},{payload:dir},{payload:dir?0:1}];\n}\nconst STOP = [{payload:0},{payload:0},{payload:0},{payload:0},{payload:0},{payload:0}];\n\n// ---- Servo: steer -100..100 -> valor 0..100 del nodo servo ----\nlet s = st.steer;\nlet servo = s < 0 ? SERVO_CENTER + (s / 100) * (SERVO_CENTER - SERVO_LEFT)\n                  : SERVO_CENTER + (s / 100) * (SERVO_RIGHT - SERVO_CENTER);\nservo = Math.round((servo - 500) / 20);   // µs → 0..100 para el nodo (500..2500)\n\n// Cancelar un arranque pendiente\nclearTimeout(context.get(\"t\"));\ncontext.set(\"t\", null);\n\nlet motorMsgs;\nif (st.cmd === \"stop\") {\n    motorMsgs = STOP;\n} else {\n    const dir = st.cmd === \"atras\" ? 1 : 0;\n    const cambioSentido = (prevCmd === \"adelante\" && st.cmd === \"atras\") ||\n                          (prevCmd === \"atras\" && st.cmd === \"adelante\");\n    if (cambioSentido) {\n        // frenar, esperar y recién ahí arrancar en el otro sentido\n        motorMsgs = pines(0, dir);\n        context.set(\"t\", setTimeout(() => {\n            node.send([...pines(st.speed, dir), null, null]);\n        }, BRAKE_MS));\n    } else {\n        motorMsgs = pines(st.speed, dir);\n    }\n}\n\nnode.status({\n    fill: st.cmd === \"stop\" ? \"red\" : \"green\", shape: \"dot\",\n    text: st.cmd + \" \" + st.speed + \"% | giro \" + st.steer + \" (servo \" + servo + \")\"\n});\n\n// Respuesta al navegador (solo si vino del tablero)\nlet resp = null;\nif (msg.res) {\n    msg.payload = { ...st, distancia: flow.get(\"distancia\") ?? null, cerca: !!flow.get(\"cerca\") };\n    resp = msg;\n}\nreturn [...motorMsgs, { payload: servo }, resp];",
    "outputs": 8,

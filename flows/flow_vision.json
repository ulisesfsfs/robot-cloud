  {
    "id": "fn",
    "type": "function",
    "z": "avanzar",
    "name": "Motores",
    "func": "// Velocidad 0..100 (% de PWM). Con batería de 9 V y motor de 6 V, no pasar de ~70.\nconst SPEED = Number(msg.speed ?? 30);\nlet dir;\nswitch (msg.payload) {\n    case \"adelante\": dir = 0; break;\n    case \"atras\":    dir = 1; break;\n    default:         // stop\n        node.status({fill:\"red\",shape:\"dot\",text:\"stop\"});\n        return [{payload:0},{payload:0},{payload:0},{payload:0},{payload:0},{payload:0}];\n}\nnode.status({fill:\"green\",shape:\"dot\",text:msg.payload+\" \"+SPEED+\"%\"});\n// [Izq PWM, Izq 1, Izq 2, Der PWM, Der 1, Der 2]\nreturn [{payload:SPEED},{payload:dir},{payload:dir?0:1},\n        {payload:SPEED},{payload:dir},{payload:dir?0:1}];",
    "outputs": 6,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 330,
    "y": 170,
    "wires": [
      [
        "p1",
        "d1"
      ],

  {
    "id": "vision-store",
    "type": "function",
    "z": "vision-tab",
    "name": "Guardar estado de visión",
    "func": "const p = msg.payload;\nif (!p || typeof p !== \"object\" || typeof p.detectado !== \"boolean\" || typeof p.modo !== \"string\") {\n    node.warn(\"Mensaje de visión inválido; se esperaba un objeto JSON con detectado y modo\");\n    return null;\n}\nconst x = Number.isFinite(p.x) ? Math.max(0, Math.min(1, p.x)) : null;\nconst area = Number.isFinite(p.area) ? Math.max(0, p.area) : null;\nglobal.set(\"robot_vision\", {\n    activo: true,\n    detectado: p.detectado,\n    modo: p.modo,\n    x,\n    area,\n    texto: typeof p.texto === \"string\" ? p.texto : null,\n    recibido: Date.now()\n});\nnode.status({ fill: p.detectado ? \"green\" : \"grey\", shape: \"dot\", text: p.modo + (p.detectado ? \" detectado\" : \" sin objeto\") });\nreturn msg;",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",

  {
    "id": "d_c2",
    "type": "comment",
    "z": "robotdash",
    "name": "Sensor de distancia: conectar acá la salida del nodo SR04 →",
    "info": "Arrastren su nodo SR04 (Trigger GPIO 18, Echo GPIO 23) y conecten su salida a la entrada de 'Distancia y freno'.\nTiene que mandar la distancia en cm en msg.payload.",
    "x": 240,
    "y": 400,
    "wires": []
  },
  {
    "id": "d_dist",
    "type": "function",
    "z": "robotdash",
    "name": "Distancia y freno",
    "func": "// Recibe la distancia del nodo SR04 (msg.payload en cm)\nconst LIMITE_CM = 20;   // mismo valor que en \"Control robot\"\nconst d = Number(msg.payload);\nif (isNaN(d) || d <= 2 || d > 400) return null;   // lecturas fuera de rango del sensor\n\nflow.set(\"distancia\", d);\nconst st = flow.get(\"robot\") || {};\nconst cerca = d < LIMITE_CM;\nflow.set(\"cerca\", cerca);\nnode.status({ fill: cerca ? \"red\" : \"green\", shape: \"dot\", text: d.toFixed(1) + \" cm\" });\n\n// Si va para adelante y aparece algo cerca, frenar\nif (cerca && st.cmd === \"adelante\") return { payload: { cmd: \"stop\" } };\nreturn null;",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 410,
    "y": 580,
    "wires": [
      [
        "d_ctl"
      ]
    ]
  },
  {
    "id": "d_get2",
    "type": "http in",
    "z": "robotdash",
    "name": "GET /robot/estado",
    "url": "/robot/estado",
    "method": "get",
    "upload": false,
    "swaggerDoc": "",
    "x": 140,
    "y": 680,
    "wires": [
      [
        "d_est"
      ]
    ]
  },
  {
    "id": "d_est",
    "type": "function",
    "z": "robotdash",
    "name": "Estado actual",
    "func": "const st = flow.get(\"robot\") || { cmd: \"stop\", speed: 60, steer: 0 };\nconst vision = global.get(\"robot_vision\");\nconst edad = vision ? Date.now() - vision.recibido : null;\nconst visionActiva = edad !== null && edad < 3000;\nmsg.payload = {\n    ...st,\n    distancia: flow.get(\"distancia\") ?? null,\n    cerca: !!flow.get(\"cerca\"),\n    vision: visionActiva\n        ? { ...vision, edad_ms: edad }\n        : { activo: false, detectado: null, modo: null, x: null, area: null, texto: null, edad_ms: edad }\n};\nreturn msg;",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 350,
    "y": 680,
    "wires": [
      [
        "d_res3"
      ]
    ]
  },
